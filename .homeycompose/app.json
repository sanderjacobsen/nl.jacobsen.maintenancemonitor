{
  "id": "nl.jacobsen.maintenancemonitor",
  "brandColor": "#E8504A",
  "version": "0.5.0",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "name": {
    "en": "Maintenance Monitor",
    "nl": "Maintenance Monitor"
  },
  "description": {
    "en": "Keeps an eye on all maintenance in and around your home, and tells you when it's time.",
    "nl": "Houdt al het onderhoud in en om je huis in de gaten en laat je weten wanneer het tijd is."
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "author": {
    "name": "Sander Jacobsen"
  },
  "contributors": {
    "developers": [
      {
        "name": "Sander Jacobsen"
      }
    ]
  },
  "api": {
    "getItems": {
      "method": "GET",
      "path": "/items"
    },
    "addItem": {
      "method": "POST",
      "path": "/items"
    },
    "updateItem": {
      "method": "PUT",
      "path": "/items/:id"
    },
    "deleteItem": {
      "method": "DELETE",
      "path": "/items/:id"
    },
    "setTasks": {
      "method": "PUT",
      "path": "/items/:id/tasks"
    },
    "markDone": {
      "method": "POST",
      "path": "/items/:id/tasks/:taskId/done"
    },
    "snooze": {
      "method": "POST",
      "path": "/items/:id/tasks/:taskId/snooze"
    },
    "getTemplates": {
      "method": "GET",
      "path": "/templates"
    },
    "getHomeyDevices": {
      "method": "GET",
      "path": "/homey-devices"
    },
    "exportData": {
      "method": "GET",
      "path": "/export"
    },
    "importData": {
      "method": "POST",
      "path": "/import"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "source": "https://github.com/sanderjacobsen/nl.jacobsen.maintenancemonitor",
  "homepage": "https://github.com/sanderjacobsen/nl.jacobsen.maintenancemonitor",
  "bugs": {
    "url": "https://github.com/sanderjacobsen/nl.jacobsen.maintenancemonitor/issues"
  },
  "support": "https://community.homey.app/t/app-pro-maintenance-monitor-keep-track-of-all-maintenance-in-and-around-your-home/161164"
}