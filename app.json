{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.jacobsen.maintenancemonitor",
  "brandColor": "#E8504A",
  "version": "0.3.0",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "name": {
    "en": "Maintenance Monitor",
    "nl": "Huisarts"
  },
  "description": {
    "en": "Keeps an eye on all maintenance in and around your home, and tells you when it's time.",
    "nl": "Houdt al het onderhoud in en om je huis in de gaten en laat je weten wanneer het tijd is."
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "author": {
    "name": "Sander Jacobsen"
  },
  "contributors": {
    "developers": [
      {
        "name": "Sander Jacobsen"
      }
    ]
  },
  "api": {
    "getItems": {
      "method": "GET",
      "path": "/items"
    },
    "addItem": {
      "method": "POST",
      "path": "/items"
    },
    "updateItem": {
      "method": "PUT",
      "path": "/items/:id"
    },
    "deleteItem": {
      "method": "DELETE",
      "path": "/items/:id"
    },
    "setTasks": {
      "method": "PUT",
      "path": "/items/:id/tasks"
    },
    "markDone": {
      "method": "POST",
      "path": "/items/:id/tasks/:taskId/done"
    },
    "snooze": {
      "method": "POST",
      "path": "/items/:id/tasks/:taskId/snooze"
    },
    "getTemplates": {
      "method": "GET",
      "path": "/templates"
    },
    "getHomeyDevices": {
      "method": "GET",
      "path": "/homey-devices"
    },
    "exportData": {
      "method": "GET",
      "path": "/export"
    },
    "importData": {
      "method": "POST",
      "path": "/import"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "A maintenance task is due",
          "nl": "Een onderhoudstaak is nodig"
        },
        "titleFormatted": {
          "en": "A task of [[item]] is due",
          "nl": "Een taak van [[item]] is nodig"
        },
        "hint": {
          "en": "Fires once when a task becomes due.",
          "nl": "Gaat één keer af als een taak nodig wordt."
        },
        "args": [
          {
            "name": "item",
            "type": "autocomplete",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "placeholder": {
              "en": "All items",
              "nl": "Alle onderdelen"
            }
          }
        ],
        "tokens": [
          {
            "name": "item",
            "type": "string",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "example": {
              "en": "Air conditioner",
              "nl": "Airco slaapkamer"
            }
          },
          {
            "name": "task",
            "type": "string",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "example": {
              "en": "Clean filters",
              "nl": "Filters schoonmaken"
            }
          },
          {
            "name": "days",
            "type": "number",
            "title": {
              "en": "Days",
              "nl": "Dagen"
            },
            "example": 7
          }
        ],
        "id": "task_due"
      },
      {
        "title": {
          "en": "A maintenance task is overdue",
          "nl": "Een onderhoudstaak is te laat"
        },
        "titleFormatted": {
          "en": "A task of [[item]] is overdue",
          "nl": "Een taak van [[item]] is te laat"
        },
        "hint": {
          "en": "Days = days past the due date.",
          "nl": "Dagen = aantal dagen over de datum."
        },
        "args": [
          {
            "name": "item",
            "type": "autocomplete",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "placeholder": {
              "en": "All items",
              "nl": "Alle onderdelen"
            }
          }
        ],
        "tokens": [
          {
            "name": "item",
            "type": "string",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "example": {
              "en": "Air conditioner",
              "nl": "Airco slaapkamer"
            }
          },
          {
            "name": "task",
            "type": "string",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "example": {
              "en": "Clean filters",
              "nl": "Filters schoonmaken"
            }
          },
          {
            "name": "days",
            "type": "number",
            "title": {
              "en": "Days",
              "nl": "Dagen"
            },
            "example": 7
          }
        ],
        "id": "task_overdue"
      },
      {
        "title": {
          "en": "A maintenance task is due soon",
          "nl": "Een onderhoudstaak is binnenkort nodig"
        },
        "titleFormatted": {
          "en": "A task of [[item]] is due soon",
          "nl": "Een taak van [[item]] is binnenkort nodig"
        },
        "hint": {
          "en": "Days = days left until the task is due.",
          "nl": "Dagen = aantal dagen tot de taak nodig is."
        },
        "args": [
          {
            "name": "item",
            "type": "autocomplete",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "placeholder": {
              "en": "All items",
              "nl": "Alle onderdelen"
            }
          }
        ],
        "tokens": [
          {
            "name": "item",
            "type": "string",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "example": {
              "en": "Air conditioner",
              "nl": "Airco slaapkamer"
            }
          },
          {
            "name": "task",
            "type": "string",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "example": {
              "en": "Clean filters",
              "nl": "Filters schoonmaken"
            }
          },
          {
            "name": "days",
            "type": "number",
            "title": {
              "en": "Days",
              "nl": "Dagen"
            },
            "example": 7
          }
        ],
        "id": "task_soon"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "!{{Has|Has no}} open maintenance tasks",
          "nl": "!{{Heeft|Heeft geen}} openstaande onderhoudstaken"
        },
        "titleFormatted": {
          "en": "[[item]] !{{has|has no}} open tasks",
          "nl": "[[item]] !{{heeft|heeft geen}} openstaande taken"
        },
        "args": [
          {
            "name": "item",
            "type": "autocomplete",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "placeholder": {
              "en": "All items",
              "nl": "Alle onderdelen"
            }
          }
        ],
        "id": "has_open_tasks"
      },
      {
        "title": {
          "en": "Task !{{is|is not}} due within … days",
          "nl": "Taak !{{is|is niet}} binnen … dagen nodig"
        },
        "titleFormatted": {
          "en": "[[task]] !{{is|is not}} due within [[days]] days",
          "nl": "[[task]] !{{is|is niet}} binnen [[days]] dagen nodig"
        },
        "args": [
          {
            "name": "task",
            "type": "autocomplete",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "placeholder": {
              "en": "Choose a task",
              "nl": "Kies een taak"
            }
          },
          {
            "name": "days",
            "type": "number",
            "min": 0,
            "max": 3650,
            "step": 1,
            "title": {
              "en": "Days",
              "nl": "Dagen"
            },
            "placeholder": {
              "en": "7",
              "nl": "7"
            }
          }
        ],
        "id": "task_due_within"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Increase a task counter",
          "nl": "Verhoog de teller van een taak"
        },
        "titleFormatted": {
          "en": "Increase counter of [[task]] by [[amount]]",
          "nl": "Verhoog teller van [[task]] met [[amount]]"
        },
        "hint": {
          "en": "Only for tasks of the type 'counter'.",
          "nl": "Alleen voor taken van het type 'teller'."
        },
        "args": [
          {
            "name": "task",
            "type": "autocomplete",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "placeholder": {
              "en": "Choose a task",
              "nl": "Kies een taak"
            }
          },
          {
            "name": "amount",
            "type": "number",
            "min": 0,
            "max": 1000000,
            "step": 0.01,
            "title": {
              "en": "Amount",
              "nl": "Aantal"
            },
            "placeholder": {
              "en": "1",
              "nl": "1"
            }
          }
        ],
        "id": "increment_counter"
      },
      {
        "title": {
          "en": "Mark all open tasks of an item as done",
          "nl": "Markeer alle openstaande taken van een onderdeel als uitgevoerd"
        },
        "titleFormatted": {
          "en": "Mark all open tasks of [[item]] as done",
          "nl": "Markeer alle openstaande taken van [[item]] als uitgevoerd"
        },
        "args": [
          {
            "name": "item",
            "type": "autocomplete",
            "title": {
              "en": "Item",
              "nl": "Onderdeel"
            },
            "placeholder": {
              "en": "Choose an item",
              "nl": "Kies een onderdeel"
            }
          }
        ],
        "id": "mark_all_done"
      },
      {
        "title": {
          "en": "Mark task as done",
          "nl": "Markeer taak als uitgevoerd"
        },
        "titleFormatted": {
          "en": "Mark [[task]] as done",
          "nl": "Markeer [[task]] als uitgevoerd"
        },
        "args": [
          {
            "name": "task",
            "type": "autocomplete",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "placeholder": {
              "en": "Choose a task",
              "nl": "Kies een taak"
            }
          }
        ],
        "id": "mark_task_done"
      },
      {
        "title": {
          "en": "Postpone a task",
          "nl": "Stel een taak uit"
        },
        "titleFormatted": {
          "en": "Postpone [[task]] by [[days]] days",
          "nl": "Stel [[task]] uit met [[days]] dagen"
        },
        "args": [
          {
            "name": "task",
            "type": "autocomplete",
            "title": {
              "en": "Task",
              "nl": "Taak"
            },
            "placeholder": {
              "en": "Choose a task",
              "nl": "Kies een taak"
            }
          },
          {
            "name": "days",
            "type": "number",
            "min": 1,
            "max": 3650,
            "step": 1,
            "title": {
              "en": "Days",
              "nl": "Dagen"
            },
            "placeholder": {
              "en": "7",
              "nl": "7"
            }
          }
        ],
        "id": "snooze_task"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Maintenance Monitor (overview)",
        "nl": "Huisarts (overzicht)"
      },
      "class": "other",
      "capabilities": [
        "alarm_maintenance",
        "maintenance_open",
        "maintenance_days",
        "maintenance_next"
      ],
      "platforms": [
        "local",
        "cloud"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/overview/assets/images/small.png",
        "large": "/drivers/overview/assets/images/large.png",
        "xlarge": "/drivers/overview/assets/images/xlarge.png"
      },
      "id": "overview"
    }
  ],
  "widgets": {
    "maintenance": {
      "name": {
        "en": "Maintenance",
        "nl": "Onderhoud"
      },
      "height": 240,
      "transparent": false,
      "settings": [
        {
          "id": "show",
          "type": "dropdown",
          "title": {
            "en": "Show",
            "nl": "Toon"
          },
          "value": "soon",
          "values": [
            {
              "id": "open",
              "title": {
                "en": "Only due and overdue tasks",
                "nl": "Alleen nodige en te late taken"
              }
            },
            {
              "id": "soon",
              "title": {
                "en": "Also tasks due soon",
                "nl": "Ook taken die binnenkort nodig zijn"
              }
            },
            {
              "id": "all",
              "title": {
                "en": "All tasks",
                "nl": "Alle taken"
              }
            }
          ]
        },
        {
          "id": "max",
          "type": "number",
          "title": {
            "en": "Maximum number of tasks",
            "nl": "Maximaal aantal taken"
          },
          "value": 6,
          "min": 1,
          "max": 30
        }
      ],
      "api": {
        "getTasks": {
          "method": "GET",
          "path": "/"
        },
        "markDone": {
          "method": "POST",
          "path": "/done"
        }
      },
      "id": "maintenance"
    }
  },
  "capabilities": {
    "alarm_maintenance": {
      "type": "boolean",
      "title": {
        "en": "Maintenance needed",
        "nl": "Onderhoud nodig"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Maintenance needed",
        "nl": "Onderhoud nodig"
      },
      "insightsTitleFalse": {
        "en": "No maintenance needed",
        "nl": "Geen onderhoud nodig"
      },
      "icon": "/assets/capabilities/alarm.svg"
    },
    "maintenance_days": {
      "type": "number",
      "title": {
        "en": "Days until next task",
        "nl": "Dagen tot volgende taak"
      },
      "units": {
        "en": "days",
        "nl": "dagen"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": false,
      "icon": "/assets/capabilities/days.svg"
    },
    "maintenance_next": {
      "type": "string",
      "title": {
        "en": "Next task",
        "nl": "Volgende taak"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/task.svg"
    },
    "maintenance_open": {
      "type": "number",
      "title": {
        "en": "Open tasks",
        "nl": "Openstaande taken"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": false,
      "icon": "/assets/capabilities/open.svg"
    }
  }
}